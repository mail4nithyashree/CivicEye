rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user's Firestore profile document exists
    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Helper function to fetch the current user's profile document from Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Role verification helpers based on users/{request.auth.uid}.role
    function isMainOfficer() {
      return isAuthenticated() && userDocExists() && (
        getUserData().role == 'main_officer' ||
        getUserData().role == 'admin' ||
        getUserData().role == 'officer'
      );
    }
    
    function isFieldInspector() {
      return isAuthenticated() && userDocExists() && (
        getUserData().role == 'field_inspector' ||
        getUserData().role == 'inspector' ||
        getUserData().role == 'officer' ||
        getUserData().role == 'admin'
      );
    }
    
    // -------------------------------------------------------------
    // Users Collection (citizens, officers, inspectors, admin)
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read, get, list: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'department'])) ||
        isMainOfficer()
      );
      allow delete: if false;
    }
    
    // -------------------------------------------------------------
    // Complaints Collection
    // -------------------------------------------------------------
    match /complaints/{complaintId} {
      allow read, get, list: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.citizenId == request.auth.uid ||
        isMainOfficer()
      );
      allow update: if isAuthenticated() && (
        (resource.data.citizenId == request.auth.uid && request.resource.data.citizenId == resource.data.citizenId) ||
        isMainOfficer() ||
        isFieldInspector()
      );
      allow delete: if isAuthenticated() && (
        resource.data.citizenId == request.auth.uid ||
        isMainOfficer()
      );
    }
    
    // -------------------------------------------------------------
    // Notifications Collection (scoped to recipient citizen/user)
    // -------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read, get, list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.citizenId == request.auth.uid ||
        isMainOfficer()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.citizenId == request.auth.uid ||
        isMainOfficer()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.citizenId == request.auth.uid ||
        isMainOfficer()
      );
    }

    // -------------------------------------------------------------
    // Analysis Logs Collection (AI Road/Non-Road & YOLO detections)
    // -------------------------------------------------------------
    match /analysis_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // -------------------------------------------------------------
    // Audit Logs Collection (Tamper-proof, readable by authorized officers)
    // -------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && isMainOfficer();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // -------------------------------------------------------------
    // Counters Collection (Atomic ID allocation for complaints)
    // -------------------------------------------------------------
    match /counters/{counterId} {
      allow read, get: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }
  }
}
