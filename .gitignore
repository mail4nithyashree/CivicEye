# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo & build outputs
.expo/
.expo-export/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision

# Metro
.metro-health-check*

# debug & logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# OS & editor artifacts
.DS_Store
Thumbs.db

# Secrets, keys, certificates, credentials
*.pem
*.key
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
*credentials*.json

# local env files (exclude all variants, keep .env.example as template)
.env
.env.*
.env*.local
!.env.example

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# PyTorch weights & experimental runs
*.pt
experiments/

